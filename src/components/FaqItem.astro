---
export interface Props {
    question: string;
    answer: string;
    id: string;
}

const { question, answer, id } = Astro.props;
---

<div class="faq-item" id={id}>
    <h3 class="faq-heading">
        <button class="faq-question" type="button" aria-expanded="false" aria-controls={`${id}-answer`} id={`${id}-question`}>
            <span>{question}</span>
            <svg class="faq-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>
    </h3>
    <div class="faq-answer" id={`${id}-answer`} role="region" aria-labelledby={`${id}-question`}>
        <div class="faq-answer-inner">
            <p set:html={answer} />
        </div>
    </div>
</div>

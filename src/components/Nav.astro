---
import ThemeSwitch from "./ThemeSwitch.astro";

export type NavKey = "home" | "projects" | "blog" | "faq" | "contact";

export interface Props {
    current?: NavKey;
}

const { current } = Astro.props;

interface DockLink {
    key: NavKey | "quote";
    label: string;
    href: string;
    /** Inner SVG markup for a 24x24 stroke icon. */
    icon: string;
}

const links: DockLink[] = [
    {
        key: "home",
        label: "Home",
        href: "/",
        icon: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V20a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9.5"/>',
    },
    {
        key: "projects",
        label: "Portfolio",
        href: "/projects.html",
        icon: '<path d="M3 7h18v13H3V7z"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>',
    },
    {
        key: "blog",
        label: "Blog",
        href: "/blog.html",
        icon: '<path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>',
    },
    {
        key: "faq",
        label: "FAQ",
        href: "/faq.html",
        icon: '<circle cx="12" cy="12" r="9"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 2-3 4"/><path d="M12 17h.01"/>',
    },
    {
        key: "contact",
        label: "Contact",
        href: "/contact.html",
        icon: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
    },
    {
        key: "quote",
        label: "Free Quote",
        href: "https://form.jotform.com/243067662032856",
        icon: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>',
    },
];
---

<header class="site-header">
    <a class="logo" href="/">
        <span class="logo-text">Logie</span>
        <span class="logo-accent">Web Services</span>
        <span class="logo-semicolon" aria-hidden="true">|</span>
    </a>

    <ThemeSwitch />
</header>

<nav class="dock" aria-label="Main">
    <ul class="dock-list">
        {links.map((link, i) => {
            const isActive = link.key === current;
            return (
                <li class="dock-item">
                    <a
                        href={link.href}
                        class:list={["dock-link", `dock-link--${link.key}`, { "is-active": isActive }]}
                        aria-current={isActive ? "page" : undefined}
                    >
                        <span class="dock-label">{link.label}</span>
                        <span class="dock-tile" style={`view-transition-name: dock-tile-${i}`}>
                            <svg class="dock-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={link.icon} />
                        </span>
                        <span class="dock-dot" style={`view-transition-name: dock-dot-${i}`} aria-hidden="true" />
                    </a>
                </li>
            );
        })}
    </ul>
</nav>

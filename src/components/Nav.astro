---
import ThemeSwitch from "./ThemeSwitch.astro";
import Icon from "./Icon.astro";
import type { IconName } from "../lib/icons";

export type NavKey = "home" | "projects" | "blog" | "faq" | "contact";

export interface Props {
    current?: NavKey;
}

const { current } = Astro.props;

interface DockLink {
    key: NavKey;
    label: string;
    href: string;
    icon: IconName;
}

const links: DockLink[] = [
    {
        key: "home",
        label: "Home",
        href: "/",
        icon: "home",
    },
    {
        key: "projects",
        label: "Portfolio",
        href: "/projects.html",
        icon: "portfolio",
    },
    {
        key: "blog",
        label: "Blog",
        href: "/blog.html",
        icon: "blog",
    },
    {
        key: "faq",
        label: "FAQ",
        href: "/faq.html",
        icon: "faq",
    },
    {
        key: "contact",
        label: "Contact",
        href: "/contact.html",
        icon: "email",
    },
];
---

<header class="site-header">
    <a class="logo" href="/">
        <span class="logo-text">Logie</span>
        <span class="logo-accent">Web Services</span>
        <span class="logo-semicolon" aria-hidden="true">|</span>
    </a>

    <ThemeSwitch />
</header>

<nav class="dock" aria-label="Main">
    <ul class="dock-list">
        {links.map((link, i) => {
            const isActive = link.key === current;
            return (
                <li class="dock-item">
                    <a
                        href={link.href}
                        class:list={["dock-link", `dock-link--${link.key}`, { "is-active": isActive }]}
                        aria-current={isActive ? "page" : undefined}
                    >
                        <span class="dock-label">{link.label}</span>
                        <span class="dock-tile" style={`view-transition-name: dock-tile-${i}`}>
                            <Icon name={link.icon} class="dock-icon" />
                        </span>
                        <span class="dock-dot" style={`view-transition-name: dock-dot-${i}`} aria-hidden="true" />
                    </a>
                </li>
            );
        })}
    </ul>
</nav>

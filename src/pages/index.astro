---
import BaseLayout from "../layouts/BaseLayout.astro";

const testimonials = [
    {
        quote: "Nathan built a new website for me and overhauled my other, making it much faster than it was before. He did some back-end work on my WordPress site to make it super easy to edit and update my products. Great to deal with and excellent work!",
        author: "Kyle de Lange",
        business: "KDL Cabins / KDL Trailers",
    },
    {
        quote: "Extremely happy with Nathan's services, and love our new website! Will be using him for all future projects!",
        author: "Jonny Findlay",
        business: "EziBuild",
    },
    {
        quote: "Absolutely great to deal with from start to finish! Nathan created exactly what I was looking for — a clean, professional, easy to navigate website. Nathan was very helpful, responsive, and easy to communicate with throughout the entire process. Pricing was very reasonable for the quality of service provided. Highly recommend Nathan!",
        author: "Sarah",
        business: "Complete Property Management",
    },
    {
        quote: "Stoked with the new website! The whole process was easy as — good communication, Nathan listened to what I wanted and made it happen. The site looks sharp, works mint on mobile and desktop, and already had a few people comment on how professional it looks. Really happy with how it turned out, would definitely recommend to anyone needing a website that does the job properly.",
        author: "Aaron",
        business: "Pivotal Property Solutions",
    },
    {
        quote: "Fast efficient and top notch service. Any questions asked are quickly responded too in a clear and concise way. He has done an amazing job with my website and I couldn't be happier. 10/10 would recommend.",
        author: "Lennox",
        business: "Lennox's Lawncare & Property Maintenance",
    },
    {
        quote: "Very professional and fast. I had so many questions that were always answered very efficiently. My website absolutely looks amazing — Logie Web Services NZ is so quick to bring your vision to life.",
        author: "Tess Reid",
    },
    {
        quote: "Excellent to deal with and reasonably priced. Would recommend to all.",
        author: "Kieran Leonard",
    },
    {
        quote: "Nate does an amazing job from start to finish. I couldn't be happier with how my website turned out. Will be recommending for sure.",
        author: "Bees Clean Detailing",
    },
];

const structuredData = {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    name: "Logie Web Services NZ",
    description: "Professional and affordable web development services for small businesses and startups in New Zealand",
    url: "https://www.logie.nz",
    email: "kiaora@logie.nz",
    hasMap: "https://share.google/KZHRxEVwJ7FY83Nue",
    address: {
        "@type": "PostalAddress",
        addressCountry: "NZ",
        addressRegion: "Whanganui",
    },
    geo: {
        "@type": "GeoCoordinates",
        latitude: "-39.93333",
        longitude: "175.05",
    },
    areaServed: [
        { "@type": "Country", name: "New Zealand" },
        { "@type": "Country", name: "Australia" },
    ],
    serviceType: ["Web Development", "Website Design", "Software Development"],
    priceRange: "$$",
    review: testimonials.map((t) => ({
        "@type": "Review",
        author: { "@type": "Person", name: t.business ? `${t.author}, ${t.business}` : t.author },
        reviewRating: { "@type": "Rating", ratingValue: "5", bestRating: "5" },
        reviewBody: t.quote,
    })),
};
---

<BaseLayout
    title="Web Development & Design Services NZ | Logie Web Services"
    description="Professional web development services in New Zealand specializing in custom websites, e-commerce solutions, and web applications. Affordable web development for small businesses, startups, and registered NZ charities."
    ogDescription="Professional web development for NZ small businesses and startups. Affordable, custom websites and e-commerce solutions with personalized service. Serving Wellington, Auckland, and beyond."
    twitterDescription="Professional web development for NZ small businesses and startups. Affordable, custom websites and e-commerce solutions with personalized service."
    path="/"
    current="home"
    structuredData={structuredData}
>
    <section class="hero-section">
        <img src="/assets/images/logienz-640.webp" alt="Logie Web Services logo" width="640" height="627" fetchpriority="high" class="profile-image profile-image--logo" />
        <div class="hero-content">
            <h1 class="intro-header">Web Development for New Zealand Businesses</h1>
            <p class="hero-sub">Custom websites that won't break the bank.</p>
            <a href="https://form.jotform.com/243067662032856" class="learn-more-button">Book a Free Quote</a>
        </div>
    </section>

    <div class="value-cards" data-elevate>
        <div class="value-card">
            <h3>Affordable</h3>
            <p>Competitive pricing for small businesses, with special discounts for registered NZ charities.</p>
        </div>
        <div class="value-card">
            <h3>Responsive</h3>
            <p>Every site looks and works great on any device: mobile, tablet, or desktop.</p>
        </div>
        <div class="value-card">
            <h3>Personal</h3>
            <p>Work directly with me, no agencies, no middlemen. Just you and your developer.</p>
        </div>
    </div>

    <section class="testimonials-section">
        <h2 class="section-title">What Clients Say</h2>
        <div class="testimonial-carousel" data-elevate role="region" aria-roledescription="carousel" aria-label="Client reviews">
            <div class="testimonial-viewport">
                <div class="testimonial-track">
                    {testimonials.map((t, i) => (
                        <div class="testimonial-slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${testimonials.length}`}>
                            <article class="testimonial-card glass-card">
                                <header class="testimonial-header">
                                    <cite class="testimonial-name">{t.author}</cite>
                                    <div class="testimonial-stars">
                                        <span aria-hidden="true">★★★★★</span>
                                        <span class="sr-only">Rated 5 out of 5 stars</span>
                                    </div>
                                </header>
                                {t.business && <p class="testimonial-meta">{t.business}</p>}
                                <blockquote class="testimonial-quote"><p>{t.quote}</p></blockquote>
                            </article>
                        </div>
                    ))}
                </div>
            </div>
            <div class="carousel-controls">
                <button type="button" class="carousel-arrow carousel-prev" aria-label="Previous review">‹</button>
                <span class="carousel-counter" aria-live="polite">1 / {testimonials.length}</span>
                <button type="button" class="carousel-arrow carousel-next" aria-label="Next review">›</button>
            </div>
        </div>
    </section>
</BaseLayout>

<script>
    import { gsap } from "gsap";

    const hero = document.querySelector(".hero-section");
    const heading = hero?.querySelector(".intro-header");
    const sub = hero?.querySelector(".hero-sub");
    const button = hero?.querySelector(".learn-more-button");
    const figure = hero?.querySelector(".profile-image");

    if (hero && heading && sub && button && figure) {
        // .learn-more-button and .profile-image each have their own CSS `transition`
        // (for hover) on the same properties GSAP drives here; left alone, the two
        // animation systems fight and the tween gets stuck at its start value. Turn
        // the CSS transition off for the entrance, then restore it afterwards.
        const buttonEl = button as HTMLElement;
        const figureEl = figure as HTMLElement;
        buttonEl.style.transition = "none";
        figureEl.style.transition = "none";

        const tl = gsap.timeline({
            delay: 0.15,
            defaults: { ease: "power2.out", duration: 0.5 },
            onComplete: () => {
                buttonEl.style.transition = "";
                figureEl.style.transition = "";
            },
        });

        tl.set(hero, { autoAlpha: 1 });
        tl.from(heading, { opacity: 0, yPercent: 40 });
        tl.from(sub, { opacity: 0, yPercent: 20 }, "-=0.3");
        tl.from(button, { opacity: 0, scale: 0.6, duration: 0.6, ease: "elastic.out(1, 0.5)" }, "-=0.2");
        tl.from(figure, { opacity: 0, duration: 0.8 }, "-=0.5");
    }
</script>

<script>
    const viewport = document.querySelector<HTMLElement>(".testimonial-viewport");
    const track = document.querySelector<HTMLElement>(".testimonial-track");
    const carousel = document.querySelector<HTMLElement>(".testimonial-carousel");
    const slides = Array.from(document.querySelectorAll<HTMLElement>(".testimonial-slide"));
    const prevBtn = document.querySelector<HTMLButtonElement>(".carousel-prev");
    const nextBtn = document.querySelector<HTMLButtonElement>(".carousel-next");
    const counter = document.querySelector<HTMLElement>(".carousel-counter");

    if (carousel && viewport && track && prevBtn && nextBtn && counter && slides.length > 0) {
        const AUTOPLAY_MS = 7000;
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        let index = 0;

        const render = () => {
            track.style.transform = `translateX(-${index * 100}%)`;
            viewport.style.height = `${slides[index].offsetHeight}px`;
            counter.textContent = `${index + 1} / ${slides.length}`;
            // Off-screen slides are hidden from assistive tech and the tab order.
            slides.forEach((slide, i) => slide.toggleAttribute("inert", i !== index));
        };

        const go = (next: number) => {
            index = (next + slides.length) % slides.length;
            render();
        };

        // Autoplay: long enough to read a full review, paused while the reader is
        // hovering/focused in the carousel or the tab is hidden, off for reduced motion,
        // and stopped for good once the visitor takes control with the arrows or a swipe.
        let autoplay: ReturnType<typeof setInterval> | undefined;
        let userControlled = reducedMotion;
        let hovering = false;
        let focused = false;

        const syncAutoplay = () => {
            const shouldRun = !userControlled && !hovering && !focused && !document.hidden;
            if (shouldRun && !autoplay) {
                autoplay = setInterval(() => go(index + 1), AUTOPLAY_MS);
            } else if (!shouldRun && autoplay) {
                clearInterval(autoplay);
                autoplay = undefined;
            }
        };

        const takeControl = (next: number) => {
            userControlled = true;
            syncAutoplay();
            go(next);
        };

        prevBtn.addEventListener("click", () => takeControl(index - 1));
        nextBtn.addEventListener("click", () => takeControl(index + 1));

        carousel.addEventListener("pointerenter", (e) => {
            if (e.pointerType === "mouse") {
                hovering = true;
                syncAutoplay();
            }
        });
        carousel.addEventListener("pointerleave", () => {
            hovering = false;
            syncAutoplay();
        });
        carousel.addEventListener("focusin", () => {
            focused = true;
            syncAutoplay();
        });
        carousel.addEventListener("focusout", (e) => {
            if (!carousel.contains(e.relatedTarget as Node | null)) {
                focused = false;
                syncAutoplay();
            }
        });
        document.addEventListener("visibilitychange", syncAutoplay);

        // Horizontal swipe on touch screens.
        let startX = 0;
        let startY = 0;
        viewport.addEventListener("touchstart", (e) => {
            startX = e.touches[0].clientX;
            startY = e.touches[0].clientY;
        }, { passive: true });
        viewport.addEventListener("touchend", (e) => {
            const dx = e.changedTouches[0].clientX - startX;
            const dy = e.changedTouches[0].clientY - startY;
            if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
                takeControl(dx < 0 ? index + 1 : index - 1);
            }
        }, { passive: true });

        window.addEventListener("resize", render);

        render();
        syncAutoplay();
    }
</script>

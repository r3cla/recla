---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import type { IconName } from "../lib/icons";
import { businessEntity } from "../lib/business";

const QUOTE_FORM = "https://form.jotform.com/243067662032856";
const EMAIL = "kiaora@logie.nz";

const steps = [
    {
        title: "Tell me about your project",
        body: "Fill in the quote form or send an email covering what your business does and what you need from a website. No technical knowledge needed.",
    },
    {
        title: "Get your free quote",
        body: "I'll come back with a clear, no-obligation quote and timeline. Most small business sites take 2–4 weeks from go-ahead to launch.",
    },
    {
        title: "Design, build & launch",
        body: "You approve the design before anything is built, and I'll keep you updated through development and testing until your site goes live.",
    },
];

const links: Array<{ icon: IconName; title: string; body: string; href: string; external?: boolean }> = [
    {
        icon: "star",
        title: "Read client reviews",
        body: "See what other NZ businesses say about working with me.",
        href: "https://share.google/KZHRxEVwJ7FY83Nue",
        external: true,
    },
    {
        icon: "facebook",
        title: "Find me on Facebook",
        body: "Follow Logie Web Services on Facebook.",
        href: "https://www.facebook.com/logienz/",
        external: true,
    },
    {
        icon: "faq",
        title: "Browse the FAQ",
        body: "Answers on pricing, timelines, hosting and more.",
        href: "/faq.html",
    },
];

const structuredData = {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: "Contact Logie Web Services",
    description: "Contact Logie Web Services, a web developer based in Whanganui, New Zealand.",
    url: "https://www.logie.nz/contact.html",
    about: businessEntity,
};
---

<BaseLayout
    title="Contact | Logie Web Services, Whanganui NZ"
    description="Contact Logie Web Services, a web developer based in Whanganui. Email kiaora@logie.nz or request a free quote for your New Zealand business website."
    ogDescription="Get in touch with a Whanganui-based web developer working with businesses across New Zealand and Australia."
    path="/contact.html"
    twitterCard="summary"
    structuredData={structuredData}
    current="contact"
>
    <div class="page-header">
        <h1 class="intro-header">Get in Touch</h1>
        <p class="page-subtitle">
            Based in Whanganui, working with small businesses and startups across New Zealand and Australia.
        </p>
    </div>

    <section class="contact-options" aria-label="Ways to get in touch" data-elevate>
        <article class="contact-card">
            <span class="icon-tile icon-tile--gold"><Icon name="quote" /></span>
            <h2>Get a free quote</h2>
            <p>
                The quickest way to get started. Answer a few questions about your business and what you need,
                and I'll put together a quote with no obligation.
            </p>
            <a href={QUOTE_FORM} class="learn-more-button">Request a Quote</a>
        </article>

        <article class="contact-card">
            <span class="icon-tile"><Icon name="email" /></span>
            <h2>Send an email</h2>
            <p>
                Have a quick question, or rather explain your project in your own words? Email me directly
                and I'll get back to you.
            </p>
            <a href={`mailto:${EMAIL}`} class="learn-more-button learn-more-button--secondary">{EMAIL}</a>
        </article>
    </section>

    <section class="contact-steps" data-elevate>
        <h2 class="section-title">What happens next</h2>
        <ol class="steps-list">
            {steps.map((step, i) => (
                <li class="step">
                    <span class="step-number" aria-hidden="true">{i + 1}</span>
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                </li>
            ))}
        </ol>
    </section>

    <section class="contact-links" aria-label="More ways to connect" data-elevate>
        <ul class="link-cards">
            {links.map((link) => (
                <li class="link-card">
                    <span class="icon-tile"><Icon name={link.icon} /></span>
                    <div>
                        <a
                            href={link.href}
                            class="link-card-title"
                            {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                        >
                            {link.title}
                            {link.external && <span class="sr-only"> (opens in a new tab)</span>}
                        </a>
                        <p>{link.body}</p>
                    </div>
                </li>
            ))}
        </ul>
        <p class="contact-privacy">
            Read how your information is handled in the <a href="/privacy.html">Privacy Notice</a>.
        </p>
    </section>
</BaseLayout>

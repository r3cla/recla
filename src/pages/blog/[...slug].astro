---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BUSINESS_ID } from "../../lib/business";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const structuredData = {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    inLanguage: "en-NZ",
    mainEntityOfPage: `https://www.logie.nz/blog/${post.id}.html`,
    image: "https://www.logie.nz/assets/images/og-image.jpg",
    author: {
        "@type": "Person",
        name: "Nathan Addison",
        url: "https://www.logie.nz/projects.html",
    },
    publisher: {
        "@type": "Organization",
        "@id": BUSINESS_ID,
        name: "Logie Web Services",
        logo: { "@type": "ImageObject", url: "https://www.logie.nz/assets/images/logienz-640.webp" },
    },
};
---

<BaseLayout
    title={`${post.data.title} | Logie Web Services`}
    description={post.data.description}
    path={`/blog/${post.id}.html`}
    ogType="article"
    structuredData={structuredData}
    current="blog"
>
    <article class="prose" data-elevate>
        <a href="/blog.html" class="blog-back">&larr; All posts</a>
        <p class="blog-meta">
            <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString("en-NZ", { year: "numeric", month: "long", day: "numeric" })}
            </time>
        </p>
        <h1>{post.data.title}</h1>
        <Content />
    </article>

    <section class="intro-section cta-section">
        <p class="intro" style="text-align: center;">Thinking about a website for your business?</p>
        <a href="https://form.jotform.com/243067662032856" class="learn-more-button">Get a Free Quote</a>
    </section>
</BaseLayout>
